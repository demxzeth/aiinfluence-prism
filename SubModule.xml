<?xml version="1.0" encoding="utf-8"?>
<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
  <Name value="AIInfluence Prism" />
  <Id value="AIInfluencePrism" />
  <Version value="v0.5.3" />
  <Author value="demxzeth" />
  <!-- See README: routes AIInfluence to any model provider. -->
  <Official value="false" />
  <DefaultModule value="false" />
  <SingleplayerModule value="true" />
  <MultiplayerModule value="false" />
  <ModuleCategory value="Singleplayer" />
  <Description>
    Route AIInfluence requests to any provider (OpenAI-compatible, Anthropic, Gemini,
    Nvidia, Ollama, KoboldCpp, Antigravity, Player2, Custom) with per-scope settings, timers and JSON repair.
  </Description>

  <DependedModules>
    <DependedModule Id="Bannerlord.Harmony" />
    <DependedModule Id="Bannerlord.MBOptionScreen" />
    <DependedModule Id="AIInfluence" />
    <DependedModule Id="Native" />
    <DependedModule Id="SandBoxCore" />
    <DependedModule Id="Sandbox" />
    <DependedModule Id="CustomBattle" />
    <DependedModule Id="StoryMode" />
  </DependedModules>

  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" />
    <DependedModuleMetadata id="Bannerlord.MBOptionScreen" order="LoadBeforeThis" />
    <DependedModuleMetadata id="AIInfluence" order="LoadBeforeThis" />
    <DependedModuleMetadata id="Native" order="LoadBeforeThis" />
    <DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis" />
    <DependedModuleMetadata id="Sandbox" order="LoadBeforeThis" />
    <DependedModuleMetadata id="CustomBattle" order="LoadBeforeThis" />
    <DependedModuleMetadata id="StoryMode" order="LoadBeforeThis" />
  </DependedModuleMetadatas>

  <SubModules>
    <SubModule>
      <Name value="AIInfluence Prism" />
      <DLLName value="AIInfluencePrism.dll" />
      <SubModuleClassType value="AIInfluencePrism.PrismCore.SubModule" />
      <Tags>
        <Tag key="DedicatedServerType" value="none" />
      </Tags>
    </SubModule>
  </SubModules>

  <Xmls />
</Module>
